# Generate with: openssl rand -hex 32
AOMORI_ADMIN_TOKEN=replace-with-a-long-random-token

# Keep loopback for a local reverse proxy. Use 0.0.0.0 only with a firewall.
AOMORI_PUBLISH_ADDRESS=127.0.0.1
AOMORI_PORT=8091
AOMORI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AOMORI_RPC_RATE_LIMIT=100

# Optional comma-separated IPs of reverse proxies allowed to supply X-Forwarded-For.
# Leave empty when clients connect directly. Values are exact IP addresses, not CIDRs.
AOMORI_TRUSTED_PROXIES=
