[Unit]
Description=Aomori single-node world server
Documentation=https://github.com/zorroforever/aomori
After=network.target
ConditionFileIsExecutable=/usr/local/bin/aomori

[Service]
Type=simple
User=aomori
Group=aomori
WorkingDirectory=/var/lib/aomori
StateDirectory=aomori
StateDirectoryMode=0700
EnvironmentFile=/etc/aomori/aomori.env
ExecStart=/usr/local/bin/aomori --listen 127.0.0.1:8091 --data-dir /var/lib/aomori --demo
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
