{
  "uid": "aomori-node",
  "title": "Aomori single-node runtime",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Node available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aomori\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "World height",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aomori_world_head{job=\"aomori\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "RPC requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aomori_rpc_requests_total{job=\"aomori\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "RPC errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aomori_rpc_errors_total{job=\"aomori\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Active event connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aomori_websocket_active{job=\"aomori\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Event lag incidents",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(aomori_websocket_lag_incidents_total{job=\"aomori\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Snapshot failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(aomori_snapshot_failures_total{job=\"aomori\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Mean RPC duration (not percentiles)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aomori-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aomori_rpc_duration_micros_total{job=\"aomori\"}[5m]) / clamp_min(rate(aomori_rpc_requests_total{job=\"aomori\"}[5m]), 0.001) / 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    }
  ]
}
