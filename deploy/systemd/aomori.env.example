# Install as /etc/aomori/aomori.env with owner root:root and mode 0600.
# Generate with: openssl rand -hex 32
AOMORI_ADMIN_TOKEN=replace-with-a-long-random-token

# Use the public HTTPS origin served by the reverse proxy.
AOMORI_CORS_ORIGINS=https://mud.example.com
AOMORI_RPC_RATE_LIMIT=100

# Set to 127.0.0.1 only when the local reverse proxy removes client-supplied
# X-Forwarded-For and constructs a trusted forwarding chain.
AOMORI_TRUSTED_PROXIES=
